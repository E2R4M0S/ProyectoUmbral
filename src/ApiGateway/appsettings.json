{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "Jwt": {
    "Authority": "http://keycloak:8080/realms/umbral",
    "Audience": "umbral-gateway",
    "ClientSecret": "${GATEWAY_CLIENT_SECRET}"
  },
  "ReverseProxy": {
    "Routes": {
      "health": {
        "ClusterId": "health-cluster",
        "Match": {
          "Path": "/health"
        }
      },
      "missions": {
        "ClusterId": "missions-cluster",
        "AuthorizationPolicy": "operator_or_admin",
        "Match": {
          "Path": "/api/missions/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/missions" }
        ]
      },
      "sessions": {
        "ClusterId": "sessions-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/sessions/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/sessions" }
        ]
      },
      "teams-register": {
        "ClusterId": "teams-cluster",
        "Match": {
          "Path": "/api/teams/register"
        }
      },
      "teams": {
        "ClusterId": "teams-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/teams/{**catch-all}"
        }
      },
      "trivia": {
        "ClusterId": "trivia-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/trivia/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/trivia" }
        ]
      },
      "admin-operators": {
        "ClusterId": "teams-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/admin/operators/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/admin" }
        ]
      },
      "admin-users": {
        "ClusterId": "teams-cluster",
        "AuthorizationPolicy": "operator_or_admin",
        "Match": {
          "Path": "/api/admin/users/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/admin" }
        ]
      },
      "admin-missions": {
        "ClusterId": "missions-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/admin/missions/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/admin" }
        ]
      },
      "realtime-hub": {
        "ClusterId": "realtimehub-cluster",
        "Match": {
          "Path": "/hub/game/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "missions-cluster": {
        "Destinations": {
          "missions": {
            "Address": "http://missions.service:80/"
          }
        }
      },
      "sessions-cluster": {
        "Destinations": {
          "sessions": {
            "Address": "http://sessions.service:80/"
          }
        }
      },
      "teams-cluster": {
        "Destinations": {
          "teams": {
            "Address": "http://teams.service:80/"
          }
        }
      },
      "trivia-cluster": {
        "Destinations": {
          "trivia": {
            "Address": "http://trivia.service:80/"
          }
        }
      },
      "realtimehub-cluster": {
        "Destinations": {
          "realtimehub": {
            "Address": "http://realtimehub:80/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
