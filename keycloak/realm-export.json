{
  "realm": "umbral",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "admin", "composite": false },
      { "name": "operator", "composite": false },
      { "name": "participant", "composite": false }
    ]
  },
  "clients": [
    {
      "clientId": "umbral-frontend",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:5173/*", "http://192.168.0.6:5173/*"],
      "webOrigins": ["http://localhost:5173", "http://192.168.0.6:5173"],
      "directAccessGrantsEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173##http://192.168.0.6:5173"
      },
      "protocolMappers": [
        {
          "name": "audience-mapper-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "umbral-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "alias-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "alias",
            "claim.name": "alias",
            "claim.value": "",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "umbral-gateway",
      "publicClient": false,
      "secret": "${GATEWAY_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "access.token.lifespan": "300"
      }
    }
  ]
}
