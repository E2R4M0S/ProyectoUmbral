{
  "realm": "umbral",
  "enabled": true,
  "sslRequired": "none",
  "attributes": {
    "defaultSignatureAlgorithm": "RS256",
    "revokeRefreshToken": "true",
    "refreshTokenMaxReuse": "0",
    "accessTokenLifespan": "300",
    "accessTokenLifespanForImplicitFlow": "900",
    "ssoSessionIdleTimeout": "1800",
    "ssoSessionMaxLifespan": "36000",
    "offlineSessionIdleTimeout": "2592000",
    "actionTokenGeneratedByAdminLifespan": "43200",
    "actionTokenGeneratedByUserLifespan": "43200"
  },
  "requiredActions": [
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": true,
      "priority": 50,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    }
  ],
  "smtpServer": {
    "host": "mailhog",
    "port": "1025",
    "from": "noreply@umbral.local",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "admin",
        "composite": false
      },
      {
        "name": "operator",
        "composite": false
      },
      {
        "name": "participant",
        "composite": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "umbral-frontend",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:5174/*",
        "http://192.168.0.2:5173/*",
        "http://192.168.0.2:5174/*",
        "http://192.168.0.4:5173/*",
        "http://192.168.0.6:5173/*",
        "http://192.168.0.10:5173/*",
        "http://192.168.31.22:5173/*",
        "http://172.20.10.6:5173/*",
        "http://192.168.0.9:5173/*",
        "http://192.168.0.5:5173/*",
        "https://localhost/*",
        "http://localhost/*",
        "umbral://callback"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:5174",
        "http://192.168.0.2:5173",
        "http://192.168.0.2:5174",
        "http://192.168.0.4:5173",
        "http://192.168.0.6:5173",
        "http://192.168.0.10:5173",
        "http://192.168.31.22:5173",
        "http://172.20.10.6:5173",
        "http://192.168.0.9:5173",
        "http://192.168.0.5:5173",
        "https://localhost",
        "http://localhost",
        "umbral://callback"
      ],
      "directAccessGrantsEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173##http://192.168.0.4:5173##http://192.168.0.6:5173##http://192.168.0.10:5173##http://192.168.0.9:5173##https://localhost"
      },
      "protocolMappers": [
        {
          "name": "audience-mapper-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "umbral-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "alias-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "alias",
            "claim.name": "alias",
            "claim.value": "",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "umbral-gateway",
      "publicClient": false,
      "secret": "${GATEWAY_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "access.token.lifespan": "300"
      }
    }
  ]
}